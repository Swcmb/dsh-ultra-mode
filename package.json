{
  "name": "dsh-ultra-mode",
  "version": "2.0.0",
  "private": true,
  "description": "DeepSeek Harness Apex Mode — a virtual highest reasoning tier that injects a high-budget execution prompt for the deepseek-v4-1-flash-261017 model or configured aliases. No settings page, no manual toggle.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tests/smoke.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node tests/smoke.mjs"
  }
}
