{
  "name": "dsh-ultra-mode",
  "version": "1.1.0",
  "private": true,
  "description": "Model-gated Ultra mode prompt bundle for DeepSeek Harness: injects high-budget instructions only for the canonical deepseek-v4-1-flash-261017 model or its configured aliases, with a fail-closed manual override.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tests/smoke.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4"
  },
  "license": "MIT",
  "scripts": {
    "test": "node tests/smoke.mjs"
  }
}
